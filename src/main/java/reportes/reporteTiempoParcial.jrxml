<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="null" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a4d5c5dc-2dcd-4804-8c74-a457a67e828b">
	<property name="ireport.zoom" value="1.3310000000000008"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="cedula" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="mes" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="anio" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    e.cedula,
    CONCAT(e.nombres, ' ', e.apellidos) AS empleado_nombre,
    e.valor_hora,
    a.fecha,
    a.hora_entrada_manana,
    a.hora_salida_manana,
    a.hora_entrada_tarde,
    a.hora_salida_tarde,
    a.minutos_atraso,
    a.horas_trabajadas,
    a.descuento,
    (a.horas_trabajadas * e.valor_hora) AS sueldo_dia
FROM empleados e
INNER JOIN asistencias a
ON e.id_empleado = a.id_empleado
WHERE e.tipo_empleado = 'TIEMPO_PARCIAL'
AND e.cedula = $P{cedula}
AND MONTH(a.fecha) = $P{mes}
AND YEAR(a.fecha) = $P{anio}
ORDER BY a.fecha ASC]]>
	</queryString>
	<field name="cedula" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="empleado_nombre" class="java.lang.String"/>
	<field name="valor_hora" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="fecha" class="java.sql.Date">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="hora_entrada_manana" class="java.sql.Time">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="hora_salida_manana" class="java.sql.Time">
