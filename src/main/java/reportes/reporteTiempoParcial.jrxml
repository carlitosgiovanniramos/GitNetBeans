	</field>
	<field name="hora_entrada_tarde" class="java.sql.Time">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="hora_salida_tarde" class="java.sql.Time">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="minutos_atraso" class="java.lang.Integer">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="horas_trabajadas" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="descuento" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="sueldo_dia" class="java.math.BigDecimal"/>
	<variable name="total_descuento_var" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{descuento}]]></variableExpression>
	</variable>
	<variable name="total_sueldo" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{sueldo_dia}]]></variableExpression>
	</variable>
	<variable name="sueldo_final_var" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{total_sueldo}.subtract(new java.math.BigDecimal($V{total_descuento_var}))]]></variableExpression>
	</variable>
